# ==============================================================================
# Campus Exchange - Server Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection
# In production, use MongoDB Atlas or secured replica set connection string
MONGODB_URI=mongodb://localhost:27017/campus_exchange

# JWT Authentication
# Replace with a cryptographically strong random key in production
JWT_SECRET=super_secure_jwt_secret_campus_exchange_2026_dev_key
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
# Restrict to trusted client domain/app origin in production
CORS_ORIGIN=*

# Image Storage Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=5
STORAGE_MAX_PHOTO_COUNT=5
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=20

# Performance & SLA Monitoring Targets
TARGET_RESPONSE_TIME_MS=3000
TARGET_AVAILABILITY_PERCENT=99.0

# Session & Security Settings
SESSION_TTL_HOURS=24
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ==============================================================================
# GMAIL SMTP CONFIGURATION
# ==============================================================================
# Use a Gmail App Password (created in Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_CAMPUS_EXCHANGE_GMAIL
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=Campus Exchange <YOUR_CAMPUS_EXCHANGE_GMAIL>

# Pilot College Default (Avanthi Institute of Engineering and Technology)
DEFAULT_COLLEGE_ID=avih-gunthapalli
DEFAULT_COLLEGE_NAME=Avanthi Institute of Engineering and Technology
DEFAULT_COLLEGE_DOMAIN=avih.edu.in
