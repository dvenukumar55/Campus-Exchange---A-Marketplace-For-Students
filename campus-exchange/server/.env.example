# ==============================================================================
# Campus Exchange - Server Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection
# In production, use MongoDB Atlas or secured replica set connection string
MONGODB_URI=mongodb://localhost:27017/campus_exchange

# JWT Authentication
# Replace with a cryptographically strong random key in production
JWT_SECRET=super_secure_jwt_secret_campus_exchange_2026_dev_key
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
# Restrict to trusted client domain/app origin in production
CORS_ORIGIN=*

# Image Storage Configuration (Pre-build gate: provider abstraction)
# Supported modes: local, s3, gcs, cloudinary
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=5
STORAGE_MAX_PHOTO_COUNT=5
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=20

# Performance & SLA Monitoring Targets (PRISM-R / PRISM-S)
TARGET_RESPONSE_TIME_MS=3000
TARGET_AVAILABILITY_PERCENT=99.0

# Pilot College Default (Avanthi Institute of Engineering and Technology)
DEFAULT_COLLEGE_ID=avih-gunthapalli
DEFAULT_COLLEGE_NAME=Avanthi Institute of Engineering and Technology
DEFAULT_COLLEGE_DOMAIN=avih.edu.in
